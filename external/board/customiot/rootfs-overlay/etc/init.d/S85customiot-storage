#!/bin/sh
# Module 07: persistent upper/work directory on the third VirtIO disk.
DATA=/mnt/customiot-data
LOWER=/usr/share/customiot/state-base
UPPER="$DATA/overlay/upper"
WORK="$DATA/overlay/work"
TARGET=/var/lib/customiot
is_mounted() { awk -v p="$1" '$2==p {ok=1} END {exit !ok}' /proc/mounts; }
start() {
    mkdir -p "$DATA" "$TARGET" /run/customiot /var/log /tmp || return 1
    if ! is_mounted "$DATA"; then
        mount -t ext4 -o rw,noatime,nosuid,nodev /dev/vdc "$DATA" || return 1
    fi
    mkdir -p "$DATA/overlay" "$UPPER" "$WORK" "$DATA/update" || return 1
    chmod 0700 "$DATA/overlay" "$WORK"
    if ! is_mounted "$TARGET"; then
        mount -t overlay overlay -o "lowerdir=$LOWER,upperdir=$UPPER,workdir=$WORK" "$TARGET" || return 1
    fi
    echo 'Persistent CustomIoT state mounted'
}
stop() {
    is_mounted "$TARGET" && umount "$TARGET"
    is_mounted "$DATA" && umount "$DATA"
    return 0
}
case "$1" in start) start;; stop) stop;; restart) stop && start;; status) is_mounted "$DATA" && is_mounted "$TARGET";; *) echo "Usage: $0 {start|stop|restart|status}"; exit 1;; esac
