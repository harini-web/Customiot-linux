#!/bin/sh
# Run INSIDE CustomIoT guest as root. Writes one persistent guest report.
set -u
OUT=/var/lib/customiot/benchmarks/module09
mkdir -p "$OUT" || { echo 'ERROR: persistent state is not writable' >&2; exit 1; }
REPORT="$OUT/guest-benchmarks.txt"
TMP="$OUT/.benchmark.$$"
trap 'rm -f "$TMP"' EXIT HUP INT TERM
{
  echo 'CUSTOMIOT GUEST BENCHMARKS (MODULE 09)'
  echo "capture_utc=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  echo "hostname=$(hostname)"
  echo "kernel=$(uname -r)"
  echo "arch=$(uname -m)"
  sed -n '/^PRETTY_NAME=/p;/^VERSION_ID=/p' /etc/os-release
  echo "boot_cmdline=$(cat /proc/cmdline)"
  echo "logical_cpus=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo unavailable)"
  echo '--- BOOT READINESS ---'
  if [ -f /var/lib/customiot/boot-ready.txt ]; then
      cat /var/lib/customiot/boot-ready.txt
  else
      echo 'N/A: add the Module 08 S99 boot marker and reboot'
  fi
  echo '--- MEMORY ---'
  awk '/^(MemTotal|MemFree|MemAvailable|Cached|Buffers|SReclaimable):/ { print }' /proc/meminfo
  awk '/^MemTotal:/ {total=$2} /^MemAvailable:/ {available=$2} END {if(total>0 && available>0) printf "estimated_used_kib=%d\n",total-available;else print "estimated_used_kib=N/A"}' /proc/meminfo
  echo '--- STORAGE ---'
  df -k / /var/lib/customiot 2>&1 || :
  grep -E ' / | /var/lib/customiot | /mnt/customiot-data ' /proc/mounts || :
  echo '--- PROCESS RSS ---'
  for name in gateway-supervisor uart-sensor-reader mosquitto mosquitto_pub; do
      for proc in /proc/[0-9]*; do
          [ -r "$proc/comm" ] || continue
          [ "$(cat "$proc/comm")" = "$name" ] || continue
          awk -v n="$name" -v pid="${proc##*/}" '/^VmRSS:/ {printf "%s pid=%s rss_kib=%s\n",n,pid,$2}' "$proc/status"
      done
  done
  echo '--- CPU: PER PROCESS CLOCK TICKS (5 SECOND WINDOW) ---'
  for name in gateway-supervisor uart-sensor-reader mosquitto; do
      pid=$(pidof "$name" 2>/dev/null | awk '{print $1}')
      if [ -n "$pid" ] && [ -r "/proc/$pid/stat" ]; then
          # /proc/PID/stat fields 14+15; comm may contain spaces, strip through final ") " first.
          before=$(sed 's/^.*) //' "/proc/$pid/stat" | awk '{print $12+$13}')
          echo "$name pid=$pid ticks_before=$before"
      else
          echo "$name pid=N/A"
      fi
  done
  sleep 5
  for name in gateway-supervisor uart-sensor-reader mosquitto; do
      pid=$(pidof "$name" 2>/dev/null | awk '{print $1}')
      if [ -n "$pid" ] && [ -r "/proc/$pid/stat" ]; then
          after=$(sed 's/^.*) //' "/proc/$pid/stat" | awk '{print $12+$13}')
          echo "$name pid=$pid ticks_after=$after"
      fi
  done
  echo 'CPU interpretation: ticks are cumulative, compare before/after for matching PIDs; sample delay 5 s.'
  echo '--- SERVICES & DEVICES ---'
  /etc/init.d/S85customiot-storage status 2>&1 || :
  /etc/init.d/S95customiot status 2>&1 || :
  ls -l /dev/ttyS1 2>&1 || :
  echo '--- MQTT BATCH THROUGHPUT: 3 REPEATS ---'
  if command -v module08-mqtt-batch >/dev/null 2>&1; then
      i=1
      while [ "$i" -le 3 ]; do
          echo "mqtt_run=$i messages=200"
          module08-mqtt-batch 200 2>&1 || echo "mqtt_run=$i FAILED"
          i=$((i+1))
      done
  else
      echo 'N/A: module08-mqtt-batch missing'
  fi
  echo '--- REGRESSION TESTS ---'
  for test in test-module03 test-module04 test-module05 test-module06 test-module07; do
      if command -v "$test" >/dev/null 2>&1; then
          echo "test=$test"
          "$test" 2>&1 || echo "test=$test FAILED"
      else
          echo "test=$test NOT_INSTALLED"
      fi
  done
  echo '--- BENCHMARK NOTES ---'
  echo 'MQTT test measures local loopback batch delivery and throughput, NOT per-message latency.'
  echo 'Boot time is kernel-start to S99 init-script marker, NOT power-on to service readiness.'
  echo 'UART end-to-end sensor feed and update tamper rejection require separate integration tests.'
} > "$TMP" 2>&1
mv "$TMP" "$REPORT"
echo "Guest report written: $REPORT"
echo 'Shut down QEMU cleanly before running the host collector.'
